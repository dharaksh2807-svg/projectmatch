// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// NextAuth Models — DO NOT MODIFY
// ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// User Model
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  isBanned      Boolean   @default(false)

  // Profile fields for project-matching
  bio              String?  @db.Text
  skills           String[] @default([])          // e.g. ["React", "Python", "TypeScript"]
  experienceLevel  String?                         // "Beginner" | "Intermediate" | "Advanced" | "Expert"
  availability     String?                         // "Full-time" | "Part-time" | "Flexible" | "Weekends"
  timezone         String?                         // IANA timezone e.g. "Asia/Kolkata"
  reputationScore  Float    @default(0)            // 0-100, computed from activity & peer feedback
  portfolioUrl     String?
  linkedinUrl      String?
  twitterHandle    String?
  instagramHandle  String?
  phoneNumber      String?

  // Relations — NextAuth
  accounts Account[]
  sessions Session[]

  // Relations — AI Agent Platform
  apiKeys       UserApiKey[]
  agents        Agent[]
  chats         Chat[]
  promptBattles PromptBattle[]
  connections   UserConnection[]

  // Relations — Project Matching
  ownedProjects  Project[]
  applications   Application[]
  notifications  Notification[]

  // Relations — Direct Messaging
  conversationsAsUserOne DirectConversation[] @relation("ConversationUserOne")
  conversationsAsUserTwo DirectConversation[] @relation("ConversationUserTwo")
  messagesSent           DirectMessage[]

  // Relations — Reviews & Endorsements
  reviewsWritten   Review[] @relation("ReviewsWritten")
  reviewsReceived  Review[] @relation("ReviewsReceived")

  // Relations — Moderation
  reportsSubmitted Report[] @relation("ReportsSubmitted")
  reportsReceived  Report[] @relation("ReportsReceived")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// AI Platform Models
// ─────────────────────────────────────────────

/// Represents an available AI model in the platform (e.g. Gemini 3.1 Pro, Claude Sonnet)
model AIModel {
  id            String  @id @default(cuid())
  name          String                       // e.g. "Gemini 3.1 Pro High"
  provider      String                       // "google" | "anthropic" | "oss"
  tier          String                       // "fast" | "high" | "thinking" | "medium"
  modelString   String                       // actual SDK model string e.g. "gemini-2.5-pro"
  contextWindow Int                          // max context in tokens
  isActive      Boolean @default(true)

  // Relations
  agents         Agent[]
  promptBattlesA PromptBattle[] @relation("ModelA")
  promptBattlesB PromptBattle[] @relation("ModelB")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
  @@index([isActive])
}

/// Per-user encrypted API key storage — one key per provider per user
model UserApiKey {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String                       // "google" | "anthropic" | "oss"
  encryptedKey String @db.Text             // AES-encrypted before storing

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

/// A user-configured AI agent with a system prompt and preferred model
model Agent {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelId      String
  model        AIModel @relation(fields: [modelId], references: [id], onDelete: Restrict)

  name         String
  systemPrompt String  @db.Text
  temperature  Float   @default(0.7)       // 0.0 – 1.0
  isPublic     Boolean @default(false)     // public agents can be used by anyone

  // Relations
  chats Chat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([modelId])
  @@index([isPublic])
}

/// A conversation session between a user and an agent
model Chat {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  title    String                           // auto-generated from first message
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([agentId])
}

/// A single message inside a Chat
model Message {
  id     String @id @default(cuid())
  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  role         MessageRole                  // USER | ASSISTANT | SYSTEM
  content      String      @db.Text
  modelUsed    String?                      // snapshot of which model generated this response
  inputTokens  Int?                         // billed input tokens for cost tracking
  outputTokens Int?                         // billed output tokens for cost tracking

  createdAt DateTime @default(now())

  @@index([chatId])
  @@index([chatId, createdAt(sort: Desc)])
}

/// Head-to-head prompt comparison — user rates which model responded better
model PromptBattle {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  prompt    String  @db.Text
  modelAId  String
  modelA    AIModel @relation("ModelA", fields: [modelAId], references: [id], onDelete: Restrict)
  modelBId  String
  modelB    AIModel @relation("ModelB", fields: [modelBId], references: [id], onDelete: Restrict)
  responseA String  @db.Text
  responseB String  @db.Text

  /// Stores "modelA" | "modelB" or null if not yet voted
  winnerId String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([modelAId])
  @@index([modelBId])
}

// ─────────────────────────────────────────────
// Multi-Platform User Connections
// ─────────────────────────────────────────────

/// Stores handle-based connections to external platforms.
/// OAuth-based platforms (GitHub, LinkedIn) are managed by NextAuth's Account table.
model UserConnection {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform     String    // "leetcode" | "codeforces" | "kaggle" | "stackoverflow" | "medium" | "hashnode" | "devto" | "hackerrank" | "gitlab" | "twitter"
  handle       String    // Username or handle on the platform
  profileUrl   String?   // Direct link to the user's profile

  // Highly compressed metadata for economical AI context injection
  metadata     Json?     // e.g. { rating: 1800, topLanguages: ["Python", "C++"], solved: 450 }

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, platform])
  @@index([userId])
}

// ─────────────────────────────────────────────
// Project Matching Domain
// ─────────────────────────────────────────────

/// A project posted by a user looking for collaborators
model Project {
  id          String  @id @default(cuid())
  ownerId     String
  owner       User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  title       String
  description String  @db.Text
  projectType String                          // "Hackathon" | "Startup" | "Open Source" | "Side Project" | "Research" | "Competition"
  duration    String                          // "< 1 week" | "1-4 weeks" | "1-3 months" | "3-6 months" | "6+ months"
  techStack   String[] @default([])           // e.g. ["React", "FastAPI", "PostgreSQL"]
  repoUrl     String?
  websiteUrl  String?
  isPublished Boolean @default(false)         // draft until published

  hackathonId String?
  hackathon   Hackathon? @relation(fields: [hackathonId], references: [id], onDelete: SetNull)

  roles       Role[]
  applications Application[]
  conversations DirectConversation[]
  reviews     Review[]
  reports     Report[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@index([isPublished])
  @@index([projectType])
}

/// An open team position on a project
model Role {
  id                     String  @id @default(cuid())
  projectId              String
  project                Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title                  String                      // e.g. "Senior Next.js Developer"
  description            String? @db.Text
  requiredSkills         String[] @default([])        // e.g. ["React", "TypeScript"]
  requiredExperienceLevel String                      // "Beginner" | "Intermediate" | "Advanced" | "Expert" | "Any"
  timeCommitment         String                      // e.g. "Part-time (10-15h/week)" | "Full-time" | "Flexible"
  headcount              Int     @default(1)          // number of people needed
  filledCount            Int     @default(0)          // how many spots are taken
  isOpen                 Boolean @default(true)

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([isOpen])
}

/// An application from a user to a specific Role
model Application {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status    ApplicationStatus @default(PENDING)
  message   String?  @db.Text              // optional cover note from the applicant

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId])               // one application per role per user
  @@index([userId])
  @@index([roleId])
  @@index([projectId])
  @@index([status])
}

/// In-app notification for a user
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  body      String   @db.Text
  link      String?                         // optional deep link e.g. /projects/clxyz
  isRead    Boolean  @default(false)
  metadata  Json?                           // extra structured data (applicationId, projectId, etc.)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

// ─────────────────────────────────────────────
// Hackathons & Messaging (P2P)
// ─────────────────────────────────────────────

/// A specific Hackathon event that projects can be associated with
model Hackathon {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  startDate   DateTime?
  endDate     DateTime?
  devpostUrl  String?
  websiteUrl  String?
  location    String?

  projects    Project[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startDate])
}

/// A P2P conversation between two users
model DirectConversation {
  id        String @id @default(cuid())
  userOneId String
  userOne   User   @relation("ConversationUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwoId String
  userTwo   User   @relation("ConversationUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  messages  DirectMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userOneId, userTwoId])
  @@index([userOneId])
  @@index([userTwoId])
  @@index([projectId])
}

/// A single direct message in a P2P conversation
model DirectMessage {
  id             String             @id @default(cuid())
  conversationId String
  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  senderId       String
  sender         User               @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  content        String             @db.Text
  isRead         Boolean            @default(false)
  
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@index([conversationId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────
// Reviews & Endorsements
// ─────────────────────────────────────────────

/// A review left by a teammate for a user after a project
model Review {
  id          String   @id @default(cuid())
  reviewerId  String
  reviewer    User     @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId  String
  reviewee    User     @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  rating      Int      // 1-5
  content     String?  @db.Text
  skillsEndorsed String[] @default([])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([reviewerId, revieweeId, projectId])
  @@index([revieweeId])
  @@index([projectId])
}

// ─────────────────────────────────────────────
// Moderation
// ─────────────────────────────────────────────

model Report {
  id             String @id @default(cuid())
  reporterId     String
  reporter       User   @relation("ReportsSubmitted", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String?
  reportedUser   User?  @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  reason         String @db.Text
  status         ReportStatus @default(PENDING)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([projectId])
  @@index([status])
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum NotificationType {
  APPLICATION_RECEIVED   // project owner gets this when someone applies
  APPLICATION_ACCEPTED   // applicant gets this when accepted
  APPLICATION_REJECTED   // applicant gets this when rejected
  NEW_MESSAGE            // any new chat message
  SYSTEM                 // platform announcements
}

enum UserRole {
  USER
  ADMIN
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

