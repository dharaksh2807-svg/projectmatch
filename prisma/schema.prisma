  USER
  ADMIN
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum CapabilityImportance {
  REQUIRED
  PREFERRED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ReviewDisputeStatus {
  PENDING
  RESOLVED
  DISMISSED
}


// ─────────────────────────────────────────────
// Hackathon Discovery Enums (Phase 3)
// ─────────────────────────────────────────────

/// Lifecycle stage of a hackathon event, driven by source data + timestamps.
enum HackathonStatus {
  UPCOMING    // start date is in the future, not yet started
  ONGOING     // currently in progress (startDate <= now <= endDate)
  ENDED       // endDate has passed
  CANCELLED   // confirmed cancellation from source or manual override
  UNKNOWN     // status cannot be determined from available data
}

/// Registration window state — independent from event lifecycle status.
enum RegistrationStatus {
  OPEN        // registration is actively accepting applications
  CLOSED      // registration deadline has passed or source says closed
  COMING_SOON // registration is announced but not yet open
  UNKNOWN     // not determinable from available data
}

/// Confidence level of the event record based on source authority + human review.
enum VerificationStatus {
  UNVERIFIED  // default: auto-imported, no human review
  VERIFIED    // confirmed by admin or trusted source verification
  FLAGGED     // marked for review due to inconsistent / suspicious data
  REJECTED    // confirmed as invalid, duplicate, or spam; hidden from users
}

/// Physical participation mode for the hackathon.
enum ParticipationMode {
  ONLINE   // fully remote / virtual
  OFFLINE  // in-person only
  HYBRID   // both in-person and remote options available
}

/// Outcome status of a background ingestion sync run.
enum SyncStatus {
  SUCCESS  // all records processed without errors
  PARTIAL  // some records processed; errors occurred for a subset
  FAILED   // ingestion run failed entirely; no records written
}

// ─────────────────────────────────────────────
// Dual-Stream Hackathon Discovery Enums
// ─────────────────────────────────────────────

/// Classifies whether a hackathon record was auto-ingested from a national
/// API source or submitted manually by a college club / event organizer.
enum HackathonStream {
  NATIONAL_AUTOMATED  // auto-synced from Devfolio, SIH, MLH, IIT feeds, etc.
  COMMUNITY_LOCAL     // organizer-uploaded: college club, student chapter, city event
}

/// Describes who is eligible to register for a hackathon.
/// Rendered as a color-coded badge on the student-facing discovery card.
enum EligibilityScope {
  OPEN_TO_ALL          // anyone: college students, working pros, high schoolers
  ANY_COLLEGE_STUDENT  // inter-college: any valid student ID from any institution
  HOST_COLLEGE_ONLY    // intra-college: strictly students of the organizing campus
}

/// Categorizes the type of entity that organized and uploaded the hackathon.
enum OrganizerType {
  COLLEGE_CLUB      // student-run technical club (e.g. GDSC, ACM, IEEE Chapter)
  STUDENT_CHAPTER   // recognized national student chapter (e.g. CSI, ISTE)
  COLLEGE_OFFICIAL  // official college department or institution (e.g. Dept. of CSE)
  COMPANY           // corporate / startup organizer (e.g. Google, a fintech startup)
  COMMUNITY         // independent tech community or open-source group
  AGGREGATED        // auto-ingested from an external aggregator (default for national stream)
}
