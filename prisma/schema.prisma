// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// NextAuth Models — DO NOT MODIFY
// ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// User Model
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  isBanned      Boolean   @default(false)

  // Profile fields for project-matching
  bio              String?  @db.Text
  skills           String[] @default([])          // e.g. ["React", "Python", "TypeScript"]
  experienceLevel  String?                         // "Beginner" | "Intermediate" | "Advanced" | "Expert"
  availability     String?                         // "Full-time" | "Part-time" | "Flexible" | "Weekends"
  timezone         String?                         // IANA timezone e.g. "Asia/Kolkata"
  reputationScore  Float    @default(0)            // 0-100, computed from activity & peer feedback
  portfolioUrl     String?
  linkedinUrl      String?
  githubUrl        String?
  leetcodeUrl      String?
  codeforcesUrl    String?
  hackerrankUrl    String?
  kaggleUrl        String?
  resumeUrl        String?
  twitterHandle    String?
  instagramHandle  String?
  phoneNumber      String?

  // Relations — NextAuth
  accounts Account[]
  sessions Session[]

  // Relations — AI Agent Platform
  apiKeys       UserApiKey[]
  agents        Agent[]
  chats         Chat[]
  promptBattles PromptBattle[]
  connections   UserConnection[]

  // Relations — Project Matching
  ownedProjects    Project[]
  applications     Application[]
  notifications    Notification[]
  roleBookmarks    RoleBookmark[]
  savedSearches    SavedSearch[]
  previousProjects PreviousProject[]
  sentInvitations  TeamInvitation[] @relation("SentInvitations")
  invitationRedemptions InvitationRedemption[]
  schedule         UserSchedule?

  // Relations — Direct Messaging
  conversationsAsUserOne DirectConversation[] @relation("ConversationUserOne")
  conversationsAsUserTwo DirectConversation[] @relation("ConversationUserTwo")
  messagesSent           DirectMessage[]

  // Relations — Reviews & Endorsements
  reviewsWritten   Review[] @relation("ReviewsWritten")
  reviewsReceived  Review[] @relation("ReviewsReceived")

  // Relations — Moderation
  reportsSubmitted Report[] @relation("ReportsSubmitted")
  reportsReceived  Report[] @relation("ReportsReceived")

  // Relations — Hackathon Submissions (Local & College Stream)
  submittedHackathons Hackathon[] @relation("UserSubmittedHackathons")

  // ── College / Location Profile (for 1-click campus filter) ──────────────
  collegeName String?  // e.g. "SRM Institute of Science and Technology"
  collegeSlug String?  // e.g. "srm-ist" — normalized for fast query matching
  city        String?  // e.g. "Chennai" — used to default city filter on login

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// AI Platform Models
// ─────────────────────────────────────────────

/// Represents an available AI model in the platform (e.g. Gemini 3.1 Pro, Claude Sonnet)
model AIModel {
  id            String  @id @default(cuid())
  name          String                       // e.g. "Gemini 3.1 Pro High"
  provider      String                       // "google" | "anthropic" | "oss"
  tier          String                       // "fast" | "high" | "thinking" | "medium"
  modelString   String                       // actual SDK model string e.g. "gemini-2.5-pro"
  contextWindow Int                          // max context in tokens
  isActive      Boolean @default(true)

  // Relations
  agents         Agent[]
  promptBattlesA PromptBattle[] @relation("ModelA")
  promptBattlesB PromptBattle[] @relation("ModelB")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
  @@index([isActive])
}

/// Per-user encrypted API key storage — one key per provider per user
model UserApiKey {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String                       // "google" | "anthropic" | "oss"
  encryptedKey String @db.Text             // AES-encrypted before storing

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

/// A user-configured AI agent with a system prompt and preferred model
model Agent {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelId      String
  model        AIModel @relation(fields: [modelId], references: [id], onDelete: Restrict)

  name         String
  systemPrompt String  @db.Text
  temperature  Float   @default(0.7)       // 0.0 – 1.0
  isPublic     Boolean @default(false)     // public agents can be used by anyone

  // Relations
  chats Chat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([modelId])
  @@index([isPublic])
}

/// A conversation session between a user and an agent
model Chat {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  title    String                           // auto-generated from first message
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([agentId])
}

/// A single message inside a Chat
model Message {
  id     String @id @default(cuid())
  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  role         MessageRole                  // USER | ASSISTANT | SYSTEM
  content      String      @db.Text
  modelUsed    String?                      // snapshot of which model generated this response
  inputTokens  Int?                         // billed input tokens for cost tracking
  outputTokens Int?                         // billed output tokens for cost tracking

  createdAt DateTime @default(now())

  @@index([chatId])
  @@index([chatId, createdAt(sort: Desc)])
}

/// Head-to-head prompt comparison — user rates which model responded better
model PromptBattle {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  prompt    String  @db.Text
  modelAId  String
  modelA    AIModel @relation("ModelA", fields: [modelAId], references: [id], onDelete: Restrict)
  modelBId  String
  modelB    AIModel @relation("ModelB", fields: [modelBId], references: [id], onDelete: Restrict)
  responseA String  @db.Text
  responseB String  @db.Text

  /// Stores "modelA" | "modelB" or null if not yet voted
  winnerId String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([modelAId])
  @@index([modelBId])
}

// ─────────────────────────────────────────────
// Multi-Platform User Connections
// ─────────────────────────────────────────────

/// Stores handle-based connections to external platforms.
/// OAuth-based platforms (GitHub, LinkedIn) are managed by NextAuth's Account table.
model UserConnection {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform     String    // "leetcode" | "codeforces" | "kaggle" | "stackoverflow" | "medium" | "hashnode" | "devto" | "hackerrank" | "gitlab" | "twitter"
  handle       String    // Username or handle on the platform
  profileUrl   String?   // Direct link to the user's profile

  // Highly compressed metadata for economical AI context injection
  metadata     Json?     // e.g. { rating: 1800, topLanguages: ["Python", "C++"], solved: 450 }

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, platform])
  @@index([userId])
}

// ─────────────────────────────────────────────
// Project Matching Domain
// ─────────────────────────────────────────────

/// A project posted by a user looking for collaborators
model Project {
  id          String  @id @default(cuid())
  ownerId     String
  owner       User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  title       String
  description String  @db.Text
  projectType String                          // "Hackathon" | "Startup" | "Open Source" | "Side Project" | "Research" | "Competition"
  duration    String                          // "< 1 week" | "1-4 weeks" | "1-3 months" | "3-6 months" | "6+ months"
  techStack   String[] @default([])           // e.g. ["React", "FastAPI", "PostgreSQL"]
  repoUrl     String?
  websiteUrl  String?
  driveUrl    String?                         // Optional Drive link for specs, PDF, PPT pitch deck
  isPublished Boolean @default(false)         // draft until published
  status      ProjectStatus @default(IN_PROGRESS) // "PLANNING" | "IN_PROGRESS" | "COMPLETED" | "ARCHIVED"
  completedAt DateTime?


  hackathonId String?
  hackathon   Hackathon? @relation(fields: [hackathonId], references: [id], onDelete: SetNull)

  roles       Role[]
  applications Application[]
  conversations DirectConversation[]
  reviews     Review[]
  reports     Report[]
  invitations TeamInvitation[]
  capabilityRequirements CapabilityRequirement[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@index([isPublished])
  @@index([projectType])
}

/// Explicit project capability requirement defined or customized by project owner
model CapabilityRequirement {
  id                 String               @id @default(cuid())
  projectId          String
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name               String               // e.g. "Frontend Development", "AI/ML Integration"
  category           String?              // "ENGINEERING" | "AI_ML" | "DESIGN" | "DEVOPS" | "PRODUCT" | "GENERAL"
  importance         CapabilityImportance @default(REQUIRED)
  requiredSkills     String[]             @default([]) // e.g. ["React", "TypeScript"]
  minExperienceLevel String?              // "Beginner" | "Intermediate" | "Advanced" | "Expert" | "Any"
  targetRoleTitle    String?              // e.g. "Frontend Engineer"
  description        String?              @db.Text

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([projectId])
  @@index([importance])
}

/// An open team position on a project
model Role {
  id                     String  @id @default(cuid())
  projectId              String
  project                Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title                  String                      // e.g. "Senior Next.js Developer"
  description            String? @db.Text
  requiredSkills         String[] @default([])        // e.g. ["React", "TypeScript"]
  requiredExperienceLevel String                      // "Beginner" | "Intermediate" | "Advanced" | "Expert" | "Any"
  timeCommitment         String                      // e.g. "Part-time (10-15h/week)" | "Full-time" | "Flexible"
  headcount              Int     @default(1)          // number of people needed
  filledCount            Int     @default(0)          // how many spots are taken
  isOpen                 Boolean @default(true)

  applications Application[]
  bookmarks    RoleBookmark[]
  invitations  TeamInvitation[]
  invitationRedemptions InvitationRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([isOpen])
}

/// A bookmarked/saved role by a user
model RoleBookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

/// A saved discovery search filter configuration owned by a user
model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String   // User-defined search name (e.g. "AI Hackathon Teams")
  context   String   @default("ROLES") // "ROLES" | "HACKATHONS"
  version   Int      @default(1)       // Schema version for future-proof payload evolution
  filters   Json                       // Validated, versioned filter payload

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, context])
  @@index([userId, createdAt(sort: Desc)])
}

/// An application from a user to a specific Role
model Application {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status    ApplicationStatus @default(PENDING)
  message   String?  @db.Text              // optional cover note from the applicant
  projectUrl String?                        // optional specific project demo / link for this application
  driveUrl   String?                        // optional specific drive link (PDF/PPT/document) for this application

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId])               // one application per role per user
  @@index([userId])
  @@index([roleId])
  @@index([projectId])
  @@index([status])
}

/// In-app notification for a user
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  body      String   @db.Text
  link      String?                         // optional deep link e.g. /projects/clxyz
  isRead    Boolean  @default(false)
  metadata  Json?                           // extra structured data (applicationId, projectId, etc.)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

// ─────────────────────────────────────────────
// Team Invitations
// ─────────────────────────────────────────────

/// Secure, shareable team invitation links for authorized project owners
model TeamInvitation {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roleId      String?
  role        Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  inviterId   String
  inviter     User     @relation("SentInvitations", fields: [inviterId], references: [id], onDelete: Cascade)

  // Cryptographic token storage: ONLY the sha256 hash is persisted
  tokenHash   String   @unique
  expiresAt   DateTime
  maxUses     Int      @default(1)
  usesCount   Int      @default(0)
  isRevoked   Boolean  @default(false)
  revokedAt   DateTime?

  redemptions InvitationRedemption[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([roleId])
  @@index([inviterId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([isRevoked])
}

/// Redemptions of team invitation links by users
model InvitationRedemption {
  id           String         @id @default(cuid())
  invitationId String
  invitation   TeamInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId       String
  role         Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)

  redeemedAt   DateTime       @default(now())

  @@unique([invitationId, userId])
  @@index([invitationId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// User Availability & Working Schedule Compatibility
// ─────────────────────────────────────────────

enum AvailabilityVisibility {
  PUBLIC     // Anyone can view schedule intervals
  TEAM_ONLY  // Only teammates in shared projects and owners can view detailed slots
  PRIVATE    // Only the user themselves can view
}

/// Rich weekly recurring availability schedule and event-specific overrides
model UserSchedule {
  id          String                 @id @default(cuid())
  userId      String                 @unique
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Recognized IANA time zone identifier (e.g. "America/New_York", "Asia/Kolkata")
  timezone    String

  // Total weekly working hours declared or computed
  weeklyHours Float?

  // Sharing privacy preference
  visibility  AvailabilityVisibility @default(TEAM_ONLY)

  // Weekly recurring intervals: Array of { dayOfWeek: 1..7 (1=Mon, 7=Sun), intervals: [{ start: "HH:mm", end: "HH:mm" }] }
  weeklySlots Json                   @default("[]")

  // Date-specific overrides: Array of { date: "YYYY-MM-DD", isUnavailable?: boolean, intervals?: [{ start: "HH:mm", end: "HH:mm" }], note?: string }
  overrides   Json                   @default("[]")

  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([userId])
  @@index([visibility])
}

// ─────────────────────────────────────────────
// Hackathons & Messaging (P2P)
// ─────────────────────────────────────────────

/// A specific Hackathon event that projects can be associated with.
/// Extended in Phase 3 to support API-driven discovery, lifecycle tracking,
/// ranking, deduplication, and ingestion provenance.
model Hackathon {
  id          String   @id @default(cuid())

  // ── Source Identity & Deduplication ──────────────────────────────────────
  // sourceId + sourceEventId together uniquely identify an event from a given
  // source (e.g. "hackclub" + "recajWTZ5ETkj2ua7"). canonicalUrl is a stable
  // fallback for deduplication when source IDs are unavailable.
  // Similar titles alone MUST NOT be used to deduplicate unrelated events.
  sourceId        String?   // "hackclub" | "kaggle" | "admin" | "government" …
  sourceEventId   String?   // opaque ID / slug from the upstream source
  canonicalUrl    String?   // unique stable URL used as secondary dedup key

  // ── Event Details ─────────────────────────────────────────────────────────
  name            String
  description     String?  @db.Text

  // ── Organizer ─────────────────────────────────────────────────────────────
  organizerName        String?  // e.g. "Hack Club", "Google DeepMind"
  organizerCredibility String?  // evidence string, e.g. "Verified MLH Partner"

  // ── URLs ──────────────────────────────────────────────────────────────────
  // Kept for backward compatibility; websiteUrl is the canonical official URL.
  websiteUrl       String?  // official event site (pre-existing field)
  devpostUrl       String?  // Devpost listing URL (pre-existing field)
  registrationUrl  String?  // direct registration / application link
  bannerUrl        String?  // event promotional image

  // ── Event Dates & Timezone ────────────────────────────────────────────────
  startDate             DateTime?  // event start (pre-existing field)
  endDate               DateTime?  // event end   (pre-existing field)
  registrationStartDate DateTime?  // when registration opens
  registrationDeadline  DateTime?  // when registration closes
  // Explicit IANA timezone string. All stored timestamps are UTC; this field
  // lets the UI display local times correctly. Nullable — some sources omit it.
  timezone              String?    // e.g. "Asia/Kolkata" | "America/Chicago"

  // ── Location & Participation Mode ─────────────────────────────────────────
  // location is kept for backward compatibility with existing seed data.
  // The structured fields below are populated by the ingestion engine.
  location          String?            // free-text legacy field (pre-existing)
  participationMode ParticipationMode? // ONLINE | OFFLINE | HYBRID
  city              String?
  state             String?
  country           String?
  countryCode       String?  // ISO 3166-1 alpha-2 e.g. "IN", "US"

  // ── Eligibility & Team Parameters ─────────────────────────────────────────
  eligibilityRequirements String?  @db.Text  // free-text, e.g. "Open to students"
  minTeamSize             Int?
  maxTeamSize             Int?

  // ── Technology & Themes ───────────────────────────────────────────────────
  tags   String[]  @default([])  // tech categories e.g. ["AI", "Web3", "FinTech"]
  themes String[]  @default([])  // broad themes e.g. ["Education", "Healthcare"]

  // ── Prizes & Fees ─────────────────────────────────────────────────────────
  prizeAmount   Float?   // total prize pool numeric value; null = not disclosed
  prizeCurrency String?  // ISO 4217 e.g. "INR" | "USD"; null if prizeAmount is null
  registrationFee Float? // 0 = free; null = unknown

  // ── National Classification ───────────────────────────────────────────────
  // isNational is set only when there is verifiable evidence. It must NOT be
  // assumed true for every imported event.
  isNational       Boolean  @default(false)
  nationalEvidence String?  // e.g. "Organized by MoE, listed on sih.gov.in"

  // ── Ranking ───────────────────────────────────────────────────────────────
  // Pre-computed composite importance score (0.0–1.0). Recalculated on each
  // sync by the ranking engine (Phase 6). Never user-editable.
  importanceScore  Float    @default(0.0)

  // ── Lifecycle & Status ────────────────────────────────────────────────────
  // status is the event lifecycle (driven by source + timestamps).
  // registrationStatus is independent and may differ from status
  // (e.g. registration CLOSED while event is still UPCOMING).
  status               HackathonStatus    @default(UPCOMING)
  registrationStatus   RegistrationStatus @default(UNKNOWN)
  verificationStatus   VerificationStatus @default(UNVERIFIED)

  // ── Sync Provenance ───────────────────────────────────────────────────────
  firstDiscoveredAt DateTime?  // when the record was first ingested
  lastSyncAt        DateTime?  // timestamp of last successful source sync
  lastVerifiedAt    DateTime?  // timestamp of last human or automated verification

  // ── Dual-Stream Architecture (Phase: Local & College Stream) ─────────────
  // stream distinguishes auto-ingested national events from organizer-uploaded
  // campus/city hackathons. Defaults to COMMUNITY_LOCAL so that organizer
  // submissions are correctly bucketed without an explicit value.
  stream               HackathonStream  @default(COMMUNITY_LOCAL)
  isCommunitySubmitted Boolean          @default(false)

  // ── Institutional Location (Local & College Stream) ───────────────────────
  // Structured fields for campus-specific and city-level discovery.
  // Not set for purely online national events.
  collegeName   String?  // e.g. "SRM Institute of Science and Technology"
  collegeSlug   String?  // normalized slug, e.g. "srm-ist" or "iit-madras"
  campusName    String?  // e.g. "Kattankulathur Campus"
  venueAddress  String?  // e.g. "Tech Park Hall 401, SRMIST KTR"

  // ── Eligibility & Participation Scope ────────────────────────────────────
  // Controls what filter returns this event and what badge is rendered.
  eligibilityScope      EligibilityScope @default(ANY_COLLEGE_STUDENT)
  allowedCollegeDomains String[]         @default([]) // e.g. ["@srmist.edu.in"]

  // ── Organizer Attribution (Local & College Stream) ────────────────────────
  organizerClubName String?  // e.g. "GDSC SRMIST" or "IEEE Student Branch"
  organizerContact  String?  // coordinator email, Discord, or WhatsApp link
  organizerType     OrganizerType @default(AGGREGATED)

  // Relation back to the User who uploaded (for community submissions).
  uploadedByUserId  String?
  uploadedBy        User?    @relation("UserSubmittedHackathons", fields: [uploadedByUserId], references: [id])

  // ── Existing Relation (preserved) ────────────────────────────────────────
  projects    Project[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ── Source Identity Constraint ────────────────────────────────────────────
  // Prevents duplicate records from the same upstream source.
  // Events without a sourceId (e.g. admin-entered) are excluded from this
  // constraint (nulls are excluded from unique indexes in PostgreSQL).
  @@unique([sourceId, sourceEventId])

  // ── Indexes ───────────────────────────────────────────────────────────────
  @@index([startDate])
  @@index([registrationDeadline])
  @@index([status])
  @@index([registrationStatus])
  @@index([verificationStatus])
  @@index([isNational])
  @@index([countryCode])
  @@index([importanceScore(sort: Desc)])
  @@index([sourceId])
  @@index([canonicalUrl])
  // ── New indexes for Dual-Stream filters ────────────────────────────────
  @@index([stream])
  @@index([collegeSlug])
  @@index([city])
  @@index([eligibilityScope])
  @@index([stream, city])  // Composite: "all Chennai LOCAL events"
  @@index([isCommunitySubmitted])
  @@index([uploadedByUserId])
}

/// Records the outcome of each background ingestion run for a given source.
/// Used by the admin monitoring dashboard (Phase 8) and for failure isolation.
model HackathonSyncLog {
  id                String   @id @default(cuid())

  sourceId          String   // which adapter produced this log ("hackclub", "kaggle" …)
  status            SyncStatus               // SUCCESS | PARTIAL | FAILED
  recordsDiscovered Int      @default(0)     // total raw records returned by source
  recordsInserted   Int      @default(0)     // net new events written to DB
  recordsUpdated    Int      @default(0)     // existing events refreshed
  recordsSkipped    Int      @default(0)     // duplicates or filtered records
  durationMs        Int?                     // wall-clock duration of the run
  errorMessage      String?  @db.Text        // first error message, if status != SUCCESS
  triggeredBy       String?                  // "cron" | "admin:<userId>" | "manual"

  startedAt         DateTime @default(now())
  completedAt       DateTime?

  @@index([sourceId])
  @@index([status])
  @@index([startedAt(sort: Desc)])
}

/// A P2P conversation between two users
model DirectConversation {
  id        String @id @default(cuid())
  userOneId String
  userOne   User   @relation("ConversationUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwoId String
  userTwo   User   @relation("ConversationUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  messages  DirectMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userOneId, userTwoId])
  @@index([userOneId])
  @@index([userTwoId])
  @@index([projectId])
}

/// A single direct message in a P2P conversation
model DirectMessage {
  id             String             @id @default(cuid())
  conversationId String
  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  senderId       String
  sender         User               @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  content        String             @db.Text
  isRead         Boolean            @default(false)
  
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@index([conversationId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────
// Reviews & Endorsements
// ─────────────────────────────────────────────

/// A review left by a teammate for a user after a project
model Review {
  id          String   @id @default(cuid())
  reviewerId  String
  reviewer    User     @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId  String
  reviewee    User     @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Overall composite rating (1-5)
  rating      Int
  content     String?  @db.Text
  skillsEndorsed String[] @default([])

  // Behavior-focused dimensions (1-5, nullable = not observed)
  ratingCommunication Int?
  ratingCollaboration Int?
  ratingReliability   Int?
  ratingTechnical     Int?

  // Editing policy (48h window)
  isEdited            Boolean   @default(false)
  editedAt            DateTime?

  // Reviewee response
  responseContent     String?   @db.Text
  respondedAt         DateTime?

  // Dispute and moderation integration
  isDisputed          Boolean   @default(false)
  disputeReason       String?   @db.Text
  disputeStatus       ReviewDisputeStatus?
  disputedAt          DateTime?

  reports             Report[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([reviewerId, revieweeId, projectId])
  @@index([revieweeId])
  @@index([projectId])
  @@index([isDisputed])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// Moderation
// ─────────────────────────────────────────────

model Report {
  id             String @id @default(cuid())
  reporterId     String
  reporter       User   @relation("ReportsSubmitted", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String?
  reportedUser   User?  @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewId       String?
  review         Review?  @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  
  reason         String @db.Text
  status         ReportStatus @default(PENDING)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([projectId])
  @@index([reviewId])
  @@index([status])
}

// ─────────────────────────────────────────────
// Previous Projects / Proof of Work
// ─────────────────────────────────────────────

/// Represents a past project or portfolio work completed by a user
model PreviousProject {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?  @db.Text
  techStack   String[] @default([])
  projectUrl  String?                          // live demo, web app, or video demo URL
  githubUrl   String?                          // GitHub or code repository URL
  driveUrl    String?                          // Google Drive link for PDF / PPT / project files
  fileType    String?                          // e.g. "Presentation (PPT)", "Project Report (PDF)", "Research Paper", "Pitch Deck", "Other Document"

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

